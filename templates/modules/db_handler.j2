from pymongo import MongoClient
import logging

class DatabaseHandler:
    def __init__(self, database_name):
        self.client = MongoClient("mongodb://localhost:27017/")
        self.db = self.client[database_name]
        logging.info(f"Connected to MongoDB database: {database_name}")

    def find(self, collection, query):
        try:
            logging.info(f"Fetching data from collection: {collection} with query: {query}")
            return list(self.db[collection].find(query))
        except Exception as e:
            logging.error(f"Error retrieving data: {str(e)}")
            return []

    def insert(self, collection, data):
        try:
            result = self.db[collection].insert_one(data)
            logging.info(f"Inserted data into {collection}, ID: {result.inserted_id}")
            return str(result.inserted_id)
        except Exception as e:
            logging.error(f"Error inserting data: {str(e)}")
            return None

    def update(self, collection, filter_query, update_data):
        try:
            result = self.db[collection].update_one(filter_query, update_data)
            logging.info(f"Updated {result.matched_count} records in {collection}")
            return result.matched_count
        except Exception as e:
            logging.error(f"Error updating data: {str(e)}")
            return 0

    def delete(self, collection, filter_query):
        try:
            result = self.db[collection].delete_one(filter_query)
            logging.info(f"Deleted {result.deleted_count} records from {collection}")
            return result.deleted_count
        except Exception as e:
            logging.error(f"Error deleting data: {str(e)}")
            return 0
