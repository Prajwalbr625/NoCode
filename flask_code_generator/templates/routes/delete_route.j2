@app.route('{{ path }}', methods=['DELETE'])
def {{ function_name }}():
    try:
        filter_criteria = {{ filter_criteria }}
        logging.info("DELETE request received at {{ path }} with filter: " + str(filter_criteria))
        deleted_count = db_handler.delete("{{ collection }}", filter_criteria)
        if deleted_count > 0:
            return jsonify({"message": "Deleted successfully"}), 200
        return jsonify({"error": "No records deleted"}), 404
    except Exception as e:
        logging.error(f"Error in DELETE request: {str(e)}")
        return jsonify({"error": str(e)}), 500
